# AI Linux Assistant local secrets.
# Copy this file to .env and fill in real values: cp .env.example .env
# .env is gitignored: it never gets committed, so it's safe to put real tokens in it.

# Todoist API token (Todoist app -> Settings -> Integrations -> Developer tab).
# Only needed if you want the assistant to check/add Todoist tasks (mcp.todoist.*).
TODOIST_API_TOKEN=
